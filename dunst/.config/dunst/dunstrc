[global]
frame_color = "#89b4fa"
separator_color= frame
highlight = "#89b4fa"
origin = bottom-left
monitor = 1
offset = (40, 40)
font = JetBrainsMono Nerd Font 15
[urgency_low]
background = "#1e1e2e"
